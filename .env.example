APP_NAME="ThesisBreaker AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=thesisbreaker_ai
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@thesisbreaker.ai"
MAIL_FROM_NAME="${APP_NAME}"

# Sectors API Integration
SECTORS_API_KEY=
SECTORS_BASE_URL=https://api.sectors.app/v1

# AI / LLM Provider Integration
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini

VITE_APP_NAME="${APP_NAME}"

